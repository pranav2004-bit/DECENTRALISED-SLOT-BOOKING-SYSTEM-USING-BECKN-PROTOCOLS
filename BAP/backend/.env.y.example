# BAP-Y Backend (GoFetch) — livetracker7.md Phase 2. Same BAP/backend codebase as
# BAP-X's own .env — copy this to .env.y and fill in real values (never commit
# .env.y; see docker-compose.yml's bap-y-backend service, which reads this file
# via env_file).

# --- App ---
DJANGO_ENV=local
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-y
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,bap-y-backend

# --- Database ---
# local-dev-only placeholder password, not a real credential
DATABASE_URL=postgres://bap_y:bap_y@bap-y-db:5432/bap_y
DB_CONN_MAX_AGE=60
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Cache / sessions --- (shared bap-cache container — own DB index, see
# livetracker7.md §2.2's demo-scale Redis decision; do not reuse BAP-X's 0/1)
REDIS_URL=redis://bap-cache:6379/2

# --- Registry / network identity ---
REGISTRY_BASE_URL=http://registry:8000
GATEWAY_BASE_URL=http://beckn-gateway:8000
SUBSCRIBER_ID=changeme.bap-y.example.com
UNIQUE_KEY_ID=changeme-uuid
SUBSCRIBER_URL=
BAP_SIGNING_PRIVATE_KEY_PATH=/app/data/secrets/bap_signing_key
BAP_ENCRYPTION_PRIVATE_KEY_PATH=/app/data/secrets/bap_encryption_key
ON_SUBSCRIBE_CALLBACK_PATH=/on_subscribe

# --- Payment Gateway (per BAP_details_v1.1.md §5) ---
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY_PATH=/run/secrets/payment_gateway_key

# --- HTTP client resilience defaults ---
HTTP_CLIENT_TIMEOUT_MS=5000
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_CIRCUIT_BREAKER_THRESHOLD=5

# --- Internal event bus (EDA) --- (own DB index on the shared bap-cache container;
# same queue/DLQ name as bap-backend is fine — isolated by DB index, not name)
EVENT_BUS_URL=redis://bap-cache:6379/3
EVENT_BUS_DLQ_NAME=bap-internal-dlq

# --- CORS (BAP-Y web app origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3005
CSRF_TRUSTED_ORIGINS=http://localhost:3005

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
