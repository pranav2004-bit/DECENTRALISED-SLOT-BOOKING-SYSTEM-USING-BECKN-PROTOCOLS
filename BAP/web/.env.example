# BAP Web (Next.js) — environment configuration template. Copy to .env.local and fill with real values.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8001
# livetracker5.md Phase 3.2 — Razorpay's key_id is a public identifier (like a
# publishable key), safe to expose client-side; needed to open the hosted Checkout
# widget. Never the key_secret or webhook secret, which stay server-side only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NODE_ENV=development
