# BPP-Automotive Backend (AutoCare) — livetracker7.md Phase 2. Same BPP/backend
# codebase as BPP-Beauty's own .env — copy this to .env.automotive and fill in real
# values (never commit .env.automotive; see docker-compose.yml's
# bpp-automotive-backend service, which reads this file via env_file).

# --- App ---
DJANGO_ENV=local
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-automotive
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,bpp-automotive-backend

# --- Database ---
# local-dev-only placeholder password, not a real credential
DATABASE_URL=postgres://bpp_automotive:bpp_automotive@bpp-automotive-db:5432/bpp_automotive
DB_CONN_MAX_AGE=60

# --- Cache / sessions --- (shared bpp-cache container — own DB index, see
# livetracker7.md §2.2's demo-scale Redis decision; do not reuse BPP-Beauty's 0/1
# or BPP-Medical's 2/3)
REDIS_URL=redis://bpp-cache:6379/4
RESERVATION_HOLD_TTL_SECONDS=600
RECONCILIATION_INTERVAL_SECONDS=60

# --- Registry / network identity ---
REGISTRY_BASE_URL=http://registry:8000
GATEWAY_BASE_URL=http://beckn-gateway:8000
SUBSCRIBER_ID=changeme.bpp-automotive.example.com
UNIQUE_KEY_ID=changeme-uuid
SUBSCRIBER_URL=
BPP_SIGNING_PRIVATE_KEY_PATH=/app/data/secrets/bpp_signing_key
BPP_ENCRYPTION_PRIVATE_KEY_PATH=/app/data/secrets/bpp_encryption_key
ON_SUBSCRIBE_CALLBACK_PATH=/on_subscribe

# --- Service domains (unchanged codes — see BPP/backend/bpp/settings.py) ---
DOMAIN_HEALTHCARE=ONDC:SRV13
DOMAIN_AUTOMOTIVE=BECKN:AUTO01
DOMAIN_BEAUTY=ONDC:RET13

# livetracker7.md §1.1: this instance genuinely serves Automotive only.
SUPPORTED_DOMAINS=BECKN:AUTO01

# --- HTTP client resilience defaults ---
HTTP_CLIENT_TIMEOUT_MS=5000
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_CIRCUIT_BREAKER_THRESHOLD=5

# --- Internal event bus (EDA) --- (own DB index on the shared bpp-cache container)
EVENT_BUS_URL=redis://bpp-cache:6379/5

# --- CORS (BPP-Automotive web app origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3004
CSRF_TRUSTED_ORIGINS=http://localhost:3004

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
