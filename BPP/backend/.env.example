# BPP Backend — environment configuration template. Copy to .env and fill with real values (never commit .env).

# --- App ---
DJANGO_ENV=local
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,bpp-backend

# --- Database ---
# Local dev uses Neon (managed Postgres), not a local container, as of 2026-09-02 — see
# RUNBOOK.md's "Postgres moved to Neon" note. Get your own connection string from your Neon
# project's dashboard and paste it here; this placeholder will not work as-is.
# BPP-family specifically needs the UNPOOLED string (no "-pooler" in the hostname) — this
# app's own DATABASES OPTIONS below sets statement_timeout/idle_session_timeout, which Neon's
# pooled (PgBouncer) endpoint rejects with "unsupported startup parameter" (confirmed live
# 2026-09-02, RUNBOOK.md). BAP doesn't set that OPTIONS block, so BAP's own .env.example uses
# the normal pooled string instead.
DATABASE_URL=postgresql://<user>:<password>@<your-endpoint>.neon.tech/bpp?sslmode=require&channel_binding=require
DB_CONN_MAX_AGE=60

# --- Cache / sessions ---
REDIS_URL=redis://bpp-cache:6379/0
RESERVATION_HOLD_TTL_SECONDS=600
RECONCILIATION_INTERVAL_SECONDS=60

# --- Registry / network identity ---
REGISTRY_BASE_URL=http://registry:8000
GATEWAY_BASE_URL=http://beckn-gateway:8000
SUBSCRIBER_ID=changeme.bpp.example.com
UNIQUE_KEY_ID=changeme-uuid
# The BPP's own real, publicly reachable HTTPS URL — see BAP/backend/.env.example's
# SUBSCRIBER_URL comment for the full rationale (identical here).
SUBSCRIBER_URL=
BPP_SIGNING_PRIVATE_KEY_PATH=/app/data/secrets/bpp_signing_key
BPP_ENCRYPTION_PRIVATE_KEY_PATH=/app/data/secrets/bpp_encryption_key
ON_SUBSCRIBE_CALLBACK_PATH=/on_subscribe

# --- Service domains (per BPP_details_v1.1.md — see protocol_compliance_notes_v1.1.md "Remaining
# Open Items" for the full research trail). Healthcare is a real, confirmed ONDC code (ONDC-SRV-
# Specifications' own example payload). Automotive has no genuine ONDC match — the adjacent real
# vertical (ONDC:SRV11 "Home Services") is built around a provider-travels-to-customer model, the
# opposite of this project's "bring the vehicle to a garage" design — so it deliberately keeps its
# own project-owned code instead of claiming a semantically-mismatched real one. ---
DOMAIN_HEALTHCARE=ONDC:SRV13
DOMAIN_AUTOMOTIVE=BECKN:AUTO01
DOMAIN_BEAUTY=ONDC:RET13

# livetracker7.md §1.1: which domain(s) THIS instance serves — enforced at the
# request boundary (core/domain_scope.py), independent of Registry/Gateway's own
# domain filtering. Left unset here = defaults to all 3 (this instance's own
# behavior, BPP-Beauty). A single-domain instance sets exactly one of the codes
# above — see .env.medical.example / .env.automotive.example for real examples.
# SUPPORTED_DOMAINS=ONDC:RET13

# --- HTTP client resilience defaults ---
HTTP_CLIENT_TIMEOUT_MS=5000
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_CIRCUIT_BREAKER_THRESHOLD=5

# --- Internal event bus (EDA, per BPP_details_v1.1.md §7) ---
EVENT_BUS_URL=redis://bpp-cache:6379/1
# EVENT_BUS_QUEUE_NAME/DLQ_NAME deliberately left unset — bpp/settings.py's own
# TESTING-aware default (livetracker4.md §2.1) picks the right name automatically;
# only set these explicitly if you need a genuinely custom queue/DLQ name.

# --- CORS (BPP web app origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
