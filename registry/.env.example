# Registry — environment configuration template. Copy to .env and fill with real values (never commit .env).

# --- App ---
# DJANGO_ENV values: local | dev | staging | preprod | production
DJANGO_ENV=local
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
# DJANGO_DEBUG must be false outside local/dev
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,registry

# --- Database ---
# Local dev uses Neon (managed Postgres), not a local container, as of 2026-09-02 — see
# RUNBOOK.md's "Postgres moved to Neon" note. Get your own connection string from your Neon
# project's dashboard and paste it here; this placeholder will not work as-is.
# (CI is the one exception — docker-compose.e2e.yml overrides this back to a real, disposable
# local Postgres container for isolated test runs, regardless of what's set here.)
DATABASE_URL=postgresql://<user>:<password>@<your-endpoint>.neon.tech/registry?sslmode=require&channel_binding=require
DB_CONN_MAX_AGE=60
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Registry's own signing identity (per protocol_compliance_notes_v1.1.md §A.5) ---
# Never inline the actual key value in this file — path to a mounted secret only.
REGISTRY_SIGNING_PRIVATE_KEY_PATH=/run/secrets/registry_signing_key
REGISTRY_ENCRYPTION_PRIVATE_KEY_PATH=/run/secrets/registry_encryption_key
# Automated rotation cadence in days (livetracker8.md §1.2) — `rotate_registry_keys`
# only actually rotates a key once it's at least this old; the key-rotation-scheduler
# sidecar invokes the command daily regardless, safely.
REGISTRY_KEY_ROTATION_DAYS=90

# --- Rate limits (per protocol_compliance_notes_v1.1.md §B.6 — ONDC concrete values) ---
SUBSCRIBE_RATE_LIMIT_PER_MIN=10
LOOKUP_RATE_LIMIT_PER_MIN=7600

# --- Cache / rate limiter (livetracker8.md §1.1 — Redis-backed, correct across
# gunicorn's multiple worker processes) ---
REDIS_URL=redis://registry-cache:6379/0

# --- Observability (per OBSERVABILITY.md) ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS (registry is backend-only, called by other backends, not browsers) ---
CORS_ALLOWED_ORIGINS=
